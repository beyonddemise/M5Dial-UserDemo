{
  // Sketch-folder tasks. ${input:sketch} offers every sketch directory.
  "version": "2.0.0",
  "tasks": [
    { "label": "Build", "type": "shell", "group": "build",
      "command": "\"${workspaceFolder}/tools/build.sh\" '${input:sketch}'", "problemMatcher": ["$gcc"] },
    { "label": "Upload", "type": "shell",
      "command": "\"${workspaceFolder}/tools/upload.sh\" '${input:sketch}'", "problemMatcher": [] },
    { "label": "Monitor", "type": "shell", "isBackground": true,
      "command": "\"${workspaceFolder}/tools/monitor.sh\"", "problemMatcher": [] },
    { "label": "Build+Upload+Monitor", "dependsOrder": "sequence",
      "dependsOn": ["Upload", "Monitor"], "problemMatcher": [] },
    { "label": "Device test", "type": "shell",
      "command": "\"${workspaceFolder}/tools/.venv/bin/python\" \"${workspaceFolder}/tools/device_test.py\" '${input:sketch}' --expect '${input:expect}'",
      "problemMatcher": [] },
    { "label": "Sim prepare", "type": "shell",
      "command": "\"${workspaceFolder}/tools/sim.sh\" '${input:sketch}' --prepare-only", "problemMatcher": ["$gcc"] },
    // why: the Wokwi extension simulates sim/wokwi.toml (pick it once with "Wokwi: Select Config File");
    // "Sim prepare" points it at the chosen sketch and builds the chips first. Resolving
    // ${command:wokwi-vscode.start} runs "Wokwi: Start Simulator" (command id from the extension
    // manifest, wokwi.wokwi-vscode 4.1.0); echo just gives the shell task something to run.
    { "label": "Simulate", "type": "shell", "dependsOn": ["Sim prepare"],
      "command": "echo", "args": ["${command:wokwi-vscode.start}"], "problemMatcher": [] },
    { "label": "Sim test", "type": "shell",
      "command": "\"${workspaceFolder}/tools/sim.sh\" '${input:sketch}' \"${workspaceFolder}/${input:scenario}\"",
      "problemMatcher": [] },
    { "label": "Host tests", "type": "shell",
      "command": "\"${workspaceFolder}/tools/.venv/bin/python\" -m unittest discover \"${workspaceFolder}/tools/tests\"",
      "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "sketch", "type": "pickString", "description": "Sketch to use",
      "options": ["UserDemo", "examples/DialProbe", "examples/LcdTest",
                  "examples/RtcTest", "examples/RfidTest", "examples/Brightness",
                  "examples/TempDemo", "examples/WifiScan", "examples/BleServer",
                  "examples/MemSoak", "examples/LvglDemo"],
      "default": "examples/DialProbe" },
    { "id": "scenario", "type": "pickString", "description": "Wokwi scenario (needs WOKWI_CLI_TOKEN)",
      "options": ["sim/scenarios/DialProbe/probe.test.yaml", "sim/scenarios/UserDemo/launcher.test.yaml",
                  "sim/scenarios/LcdTest/lcd_test.test.yaml", "sim/scenarios/RtcTest/rtc_test.test.yaml",
                  "sim/scenarios/Brightness/brightness.test.yaml",
                  "sim/scenarios/TempDemo/temp_demo.test.yaml",
                  "sim/scenarios/RfidTest/card.test.yaml",
                  "sim/scenarios/WifiScan/scan.test.yaml"],
      "default": "sim/scenarios/DialProbe/probe.test.yaml" },
    { "id": "expect", "type": "promptString", "description": "Regex expected in the serial log",
      "default": "init: " }
  ]
}
